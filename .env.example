# Absolute path to a Firebase service account JSON file.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/service-account.json

# Optional. firebase-admin can infer this from the service account.
FIREBASE_PROJECT_ID=

# Local emulator target. Used automatically with `eurotrex-import --commit --emulator`.
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# Optional defaults for the importer CLI.
EUROTREX_WORKBOOK_PATH=data/Cyprus_E4_Data_v4 - Cleaned-nopass.xlsx
EUROTREX_TRAIL_ID=cyprus-e4
