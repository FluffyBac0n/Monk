rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function hasVerifiedEmail() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email is string;
    }

    function isAdmin() {
      return hasVerifiedEmail() && (
        request.auth.token.admin == true ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function hasOwnerAccess(ownerId) {
      let profile = get(/databases/$(database)/documents/ownerProfiles/$(ownerId));
      return hasVerifiedEmail()
        && request.auth.uid == ownerId
        && exists(/databases/$(database)/documents/ownerProfiles/$(ownerId))
        && profile.data.email is string
        && profile.data.email == request.auth.token.email
        && (!profile.data.keys().hasAny(['accessStatus']) || profile.data.accessStatus == 'active');
    }

    function validShortString(value, maximum) {
      return value is string && value.size() > 0 && value.size() <= maximum;
    }

    function validString(value, maximum) {
      return value is string && value.size() <= maximum;
    }

    function validOptionalString(value, maximum) {
      return value == null || validString(value, maximum);
    }

    function validHttpUrl(value) {
      return value is string && value.size() <= 1000 && value.matches('https?://.+');
    }

    function validOptionalHttpUrl(value) {
      return value == null || value == '' || validHttpUrl(value);
    }

    function ownerCreateKeysOnly(data) {
      return data.keys().hasOnly([
        'trailId', 'trailName', 'stageId', 'stageName', 'stageSequence',
        'name', 'type', 'village', 'address', 'description', 'phone',
        'email', 'website', 'whatsapp', 'googleMapsUrl', 'priceMinEur',
        'priceMaxEur', 'distanceFromTrailKm', 'capacityPeople', 'monthsOpen',
        'latitude', 'longitude', 'policyAgreement', 'ownerId', 'ownerEmail',
        'status', 'reviewNote', 'createdAt', 'updatedAt'
      ]);
    }

    function submissionResultKeysOnly(data) {
      return data.keys().hasOnly([
        'trailId', 'trailName', 'stageId', 'stageName', 'stageSequence',
        'name', 'type', 'village', 'address', 'description', 'phone',
        'email', 'website', 'whatsapp', 'googleMapsUrl', 'priceMinEur',
        'priceMaxEur', 'distanceFromTrailKm', 'capacityPeople', 'monthsOpen',
        'latitude', 'longitude', 'policyAgreement', 'ownerId', 'ownerEmail',
        'status', 'reviewNote', 'createdAt', 'updatedAt',
        'publishedLodgingId', 'publishedTrailId', 'reviewedBy', 'reviewedAt'
      ]);
    }

    function requiredSubmissionKeys(data) {
      return data.keys().hasAll([
        'trailId', 'trailName', 'stageId', 'stageName', 'stageSequence',
        'name', 'type', 'village', 'address', 'description', 'phone',
        'email', 'website', 'whatsapp', 'googleMapsUrl', 'priceMinEur',
        'priceMaxEur', 'distanceFromTrailKm', 'capacityPeople', 'monthsOpen',
        'latitude', 'longitude', 'policyAgreement', 'ownerId', 'ownerEmail',
        'status', 'reviewNote', 'createdAt', 'updatedAt'
      ]);
    }

    function validOwnerSubmissionData(data) {
      return requiredSubmissionKeys(data)
        && data.ownerId == request.auth.uid
        && data.ownerEmail == request.auth.token.email
        && data.policyAgreement == true
        && validShortString(data.trailId, 120)
        && validShortString(data.trailName, 160)
        && validShortString(data.stageId, 160)
        && validShortString(data.stageName, 160)
        && data.stageSequence is number
        && data.stageSequence >= 0
        && data.stageSequence <= 100000
        && validShortString(data.name, 160)
        && data.type in ['Hotel', 'Guesthouse', 'Hostel', 'Apartment', 'Villa', 'Camping']
        && validShortString(data.village, 160)
        && validShortString(data.address, 300)
        && validShortString(data.description, 800)
        && validShortString(data.phone, 80)
        && validShortString(data.email, 254)
        && validHttpUrl(data.website)
        && validOptionalString(data.whatsapp, 80)
        && validOptionalHttpUrl(data.googleMapsUrl)
        && data.priceMinEur is number
        && data.priceMinEur >= 0
        && data.priceMinEur <= 1000000
        && data.priceMaxEur is number
        && data.priceMaxEur >= data.priceMinEur
        && data.priceMaxEur <= 1000000
        && data.distanceFromTrailKm is number
        && data.distanceFromTrailKm >= 0
        && data.distanceFromTrailKm <= 1000
        && (data.capacityPeople == null || (data.capacityPeople is number && data.capacityPeople >= 1 && data.capacityPeople <= 100000))
        && validOptionalString(data.monthsOpen, 160)
        && (data.latitude == null || (data.latitude is number && data.latitude >= -90 && data.latitude <= 90))
        && (data.longitude == null || (data.longitude is number && data.longitude >= -180 && data.longitude <= 180))
        && validString(data.reviewNote, 1000)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && exists(/databases/$(database)/documents/trails/$(data.trailId)/stages/$(data.stageId));
    }

    function hasPublishedVersion(data) {
      return data.keys().hasAll(['publishedLodgingId', 'publishedTrailId'])
        && validShortString(data.publishedLodgingId, 200)
        && validShortString(data.publishedTrailId, 120);
    }

    function validOwnerTransition(beforeData, after) {
      return (
        beforeData.status in ['draft', 'pending']
        && after == 'pending'
      ) || (
        beforeData.status in ['approved', 'pending_update']
        && after == 'pending_update'
      ) || (
        beforeData.status in ['changes_requested', 'rejected']
        && after == (hasPublishedVersion(beforeData) ? 'pending_update' : 'pending')
      );
    }

    function draftValueKeysOnly(data) {
      return data.keys().hasOnly([
        'trailId', 'trailName', 'stageId', 'stageName', 'stageSequence',
        'name', 'type', 'village', 'address', 'description', 'phone',
        'email', 'website', 'whatsapp', 'googleMapsUrl', 'priceMinEur',
        'priceMaxEur', 'distanceFromTrailKm', 'capacityPeople', 'monthsOpen',
        'latitude', 'longitude', 'policyAgreement'
      ]) && data.keys().hasAll([
        'trailId', 'trailName', 'stageId', 'stageName', 'stageSequence',
        'name', 'type', 'village', 'address', 'description', 'phone',
        'email', 'website', 'whatsapp', 'googleMapsUrl', 'priceMinEur',
        'priceMaxEur', 'distanceFromTrailKm', 'capacityPeople', 'monthsOpen',
        'latitude', 'longitude', 'policyAgreement'
      ]);
    }

    function validDraftValues(data) {
      return data is map
        && draftValueKeysOnly(data)
        && validString(data.trailId, 120)
        && validString(data.trailName, 160)
        && validString(data.stageId, 160)
        && validString(data.stageName, 160)
        && data.stageSequence is number
        && data.stageSequence >= 0
        && data.stageSequence <= 100000
        && validString(data.name, 160)
        && data.type in ['Hotel', 'Guesthouse', 'Hostel', 'Apartment', 'Villa', 'Camping']
        && validString(data.village, 160)
        && validString(data.address, 300)
        && validString(data.description, 800)
        && validString(data.phone, 80)
        && validString(data.email, 254)
        && validString(data.website, 1000)
        && validString(data.whatsapp, 80)
        && validString(data.googleMapsUrl, 1000)
        && validString(data.priceMinEur, 32)
        && validString(data.priceMaxEur, 32)
        && validString(data.distanceFromTrailKm, 32)
        && validString(data.capacityPeople, 32)
        && validString(data.monthsOpen, 160)
        && validString(data.latitude, 32)
        && validString(data.longitude, 32)
        && data.policyAgreement is bool;
    }

    match /trails/{trailId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /trails/{trailId}/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /ownerProfiles/{ownerId} {
      allow get: if isAdmin() || (hasVerifiedEmail() && request.auth.uid == ownerId);
      allow list, update, delete: if isAdmin();

      allow create: if isAdmin() || (
        signedIn()
        && request.auth.uid == ownerId
        && request.auth.token.email is string
        && request.resource.data.keys().hasOnly([
          'email', 'businessName', 'accessStatus', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'email', 'businessName', 'accessStatus', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.email == request.auth.token.email
        && validShortString(request.resource.data.email, 254)
        && validShortString(request.resource.data.businessName, 160)
        && request.resource.data.accessStatus == 'pending'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
      );
    }

    match /accommodationSubmissions/{submissionId} {
      allow read: if isAdmin() || (hasOwnerAccess(resource.data.ownerId) && resource.data.ownerId == request.auth.uid);

      allow create: if isAdmin() || (
        hasOwnerAccess(request.resource.data.ownerId)
        && ownerCreateKeysOnly(request.resource.data)
        && validOwnerSubmissionData(request.resource.data)
        && request.resource.data.status == 'pending'
        && request.resource.data.reviewNote == ''
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
      );

      allow update: if isAdmin() || (
        hasOwnerAccess(resource.data.ownerId)
        && resource.data.ownerId == request.auth.uid
        && submissionResultKeysOnly(request.resource.data)
        && validOwnerSubmissionData(request.resource.data)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.ownerEmail == resource.data.ownerEmail
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.reviewNote == ''
        && request.resource.data.updatedAt == request.time
        && validOwnerTransition(resource.data, request.resource.data.status)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'trailId', 'trailName', 'stageId', 'stageName', 'stageSequence',
          'name', 'type', 'village', 'address', 'description', 'phone',
          'email', 'website', 'whatsapp', 'googleMapsUrl', 'priceMinEur',
          'priceMaxEur', 'distanceFromTrailKm', 'capacityPeople', 'monthsOpen',
          'latitude', 'longitude', 'policyAgreement', 'status', 'reviewNote',
          'updatedAt'
        ])
      );

      allow delete: if isAdmin() || (
        hasOwnerAccess(resource.data.ownerId)
        && resource.data.ownerId == request.auth.uid
        && resource.data.status in ['draft', 'rejected', 'changes_requested']
      );
    }

    match /accommodationDrafts/{draftId} {
      allow read: if hasOwnerAccess(resource.data.ownerId) && resource.data.ownerId == request.auth.uid;

      allow create: if hasOwnerAccess(request.resource.data.ownerId)
        && request.resource.data.keys().hasOnly([
          'ownerId', 'ownerEmail', 'sourceSubmissionId', 'currentStep',
          'values', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'ownerId', 'ownerEmail', 'sourceSubmissionId', 'currentStep',
          'values', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerEmail == request.auth.token.email
        && validString(request.resource.data.sourceSubmissionId, 200)
        && request.resource.data.currentStep is number
        && request.resource.data.currentStep >= 1
        && request.resource.data.currentStep <= 4
        && validDraftValues(request.resource.data.values)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if hasOwnerAccess(resource.data.ownerId)
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'ownerId', 'ownerEmail', 'sourceSubmissionId', 'currentStep',
          'values', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.ownerEmail == resource.data.ownerEmail
        && validString(request.resource.data.sourceSubmissionId, 200)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.currentStep is number
        && request.resource.data.currentStep >= 1
        && request.resource.data.currentStep <= 4
        && validDraftValues(request.resource.data.values)
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'sourceSubmissionId', 'currentStep', 'values', 'updatedAt'
        ]);

      allow delete: if hasOwnerAccess(resource.data.ownerId) && resource.data.ownerId == request.auth.uid;
    }

    match /admins/{adminId} {
      allow get: if isAdmin() || (hasVerifiedEmail() && request.auth.uid == adminId);
      allow list, create, update, delete: if isAdmin();
    }

    match /accommodationAudit/{entryId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'submissionId', 'lodgingId', 'trailId', 'ownerId',
          'accommodationName', 'action', 'note', 'actorId', 'actorEmail',
          'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'submissionId', 'lodgingId', 'trailId', 'ownerId',
          'accommodationName', 'action', 'note', 'actorId', 'actorEmail',
          'createdAt'
        ])
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.actorEmail == request.auth.token.email
        && request.resource.data.action in ['approved', 'changes_requested', 'rejected', 'removed']
        && validString(request.resource.data.submissionId, 200)
        && validString(request.resource.data.lodgingId, 200)
        && validString(request.resource.data.trailId, 120)
        && validString(request.resource.data.ownerId, 200)
        && validString(request.resource.data.accommodationName, 160)
        && validString(request.resource.data.note, 1000)
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
